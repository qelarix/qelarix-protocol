# ============================================================
# AI PLATFORMA — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in real values.
# cp .env.local.example .env.local
# ============================================================

# --- SUPABASE ---
# Find at: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- SOLANA ---
# Cluster this deployment serves: devnet | mainnet-beta. Unset = wallet sign-in, credit campaigns
# and QLC payments are disabled. Mainnet payments stay disabled in code until the launch task.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional server-side RPC endpoints (may contain an API key; never NEXT_PUBLIC). Default: public RPC.
SOLANA_RPC_URL=
SOLANA_WS_URL=
# QLC (on-chain Token-2022). Payment assets, treasuries and prices are database configuration
# (payment_assets, qlc_price_packs), not environment variables.
# The cluster's QLC mint, created by scripts/qlc-setup.ts.
QLC_MINT_ADDRESS=
# Operator keypair (JSON byte array): relayer and fee payer for the QLC program; it holds no token
# authority and cannot admit members alone. Server secret only, placed by the owner personally:
# never commit, log or paste it anywhere. Unset = QLC purchases off.
QLC_OPERATOR_SECRET_KEY=
# Internal (founder / team) accounts: comma-separated Solana wallet addresses that get unlimited
# access (plan and credit gates skipped). Server-side only; empty = no internal accounts.
INTERNAL_WALLET_ADDRESSES=
# Bearer secret for the cron routes (/api/cron/*), at least 32 characters; Vercel Cron sends it.
# Unset or shorter = cron jobs refuse to run (QLC payment recovery: /api/cron/qlc-payments, or run
# npm run worker:qlc-payments). Generate: openssl rand -base64 48
CRON_SECRET=
# Optional: trusted request header carrying the visitor's country code for regional QLC prices
# (e.g. x-vercel-ip-country). Unset = global prices only.
PRICING_REGION_HEADER=

# --- APP URL ---
# Base URL for server-side callbacks (Cinema Studio export). Sign-in is wallet-only (Supabase Web3);
# no OAuth or NextAuth secrets are used. The variable keeps its former name.
NEXTAUTH_URL=http://localhost:3000

# --- STRIPE ---
# Find at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create at: https://dashboard.stripe.com/products
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_AGENCY=price_agency_id

# Stripe Top-up Credit Packs
STRIPE_PRICE_TOPUP_500=price_topup_500_id
STRIPE_PRICE_TOPUP_1500=price_topup_1500_id
STRIPE_PRICE_TOPUP_5000=price_topup_5000_id
STRIPE_PRICE_TOPUP_15000=price_topup_15000_id

# --- AI PROVIDERS ---
# fal.ai: https://fal.ai/dashboard/keys
FAL_KEY=your-fal-key
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Google Gemini: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-key
# xAI (Grok): https://console.x.ai/
XAI_API_KEY=your-xai-key
# Stability AI: https://platform.stability.ai/account/keys
STABILITY_API_KEY=your-stability-key
# MUAPI (Happy Horse 1.0, Infinite Talk): https://muapi.ai/dashboard
MUAPI_API_KEY=your-muapi-api-key

# --- EMAIL (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# --- APP ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
